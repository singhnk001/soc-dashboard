# .env.example — copy to .env and fill in real values
# Never commit .env to git

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/SOC_DB

# FastAPI JWT secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# AlienVault OTX API key (get from otx.alienvault.com → Account → API Key)
# Set this via the Settings modal in the UI, not directly in this file
OTX_API_KEY=

# AbuseIPDB API key (get from abuseipdb.com → API)
ABUSEIPDB_API_KEY=

# Optional: Slack webhook for SOAR playbook notifications
SLACK_WEBHOOK_URL=

# Optional: Microsoft Teams webhook for SOAR playbook notifications
TEAMS_WEBHOOK_URL=
