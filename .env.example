# .env.example — copy to .env and fill in real values
# Never commit .env to git

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8002

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=soc_db

# Security & Secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Threat Intelligence API Keys (can also be configured via Settings in UI)
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
ABUSEIPDB_API_KEY=

# SOAR Playbook Webhook Integrations
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
